VITE_API_ENV=production
VITE_APP_ID=app-9f5q2s385ibl

# ── Configurable Base URLs ────────────────────────────────────────────────
BASE_URL=https://your-backend-domain.hostingersite.com
VITE_BASE_URL=https://your-backend-domain.hostingersite.com
VITE_BACKEND_URL=https://your-backend-domain.hostingersite.com
VITE_SITE_URL=https://your-backend-domain.hostingersite.com
VITE_API_BASE_URL=/backend

# Database Configuration
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# Allowed CORS Origins (comma-separated list)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,https://your-backend-domain.hostingersite.com

# Google Maps Geocoding API Key (used securely on backend only)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Session Inactivity Timeout (3600 seconds = 1 hour) — Regular Users
SESSION_TIMEOUT_SECONDS=3600

# Admin Session Timeout (28800 seconds = 8 hours)
ADMIN_SESSION_TIMEOUT_SECONDS=28800

# Debug Logging (set to true ONLY in local development — never in production)
APP_DEBUG=false

# WhatsApp Notification via CallMeBot (set your API key to enable order alerts)
CALLMEBOT_APIKEY=

# SMTP & Email Delivery Settings (used by backend/mailer.php)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@ohmygudness.in
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=info@ohmygudness.in
SMTP_FROM_NAME="OH MY GUDNESS"
SMTP_SECURE=ssl
